{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  // vendor/ is the synced theme; it is checked where it is developed (gh-pages-template).
  // public/demo/lib/ is generated (wasm-bindgen glue, copied by scripts/demo-assets.mjs).
  "exclude": ["dist", "vendor", "public/demo/lib"]
}
