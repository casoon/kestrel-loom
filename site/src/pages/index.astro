---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
import {
  Badge,
  Badges,
  BuildOutput,
  Button,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';

// The golden fixtures of the core: one committed RenderCommand stream per scene,
// compared by `cargo test -p kestrel-loom --test golden_render_commands`.
const fixtures = import.meta.glob<string>('../../../crates/renderer/tests/fixtures/*.txt', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const fixture = (name: string) => {
  const text = fixtures[`../../../crates/renderer/tests/fixtures/${name}.txt`];
  if (text === undefined) throw new Error(`fixture ${name} not found`);
  return text;
};
const tools = fixture('tools_trend_and_level');
const rsi = fixture('full_frame_with_rsi_pane');
const head = (text: string, lines: number) => text.split('\n').slice(0, lines).join('\n');

// The indicator catalogue as the WASM build reports it — the same package the demo
// loads, built by ./build-wasm.sh before the site (see scripts/demo-assets.mjs).
const pkg = join(process.cwd(), '..', 'pkg');
const wasm = await import(/* @vite-ignore */ pathToFileURL(join(pkg, 'kestrel_loom_wasm.js')).href);
wasm.initSync({ module: readFileSync(join(pkg, 'kestrel_loom_wasm_bg.wasm')) });
const indicatorCount = (JSON.parse(wasm.WasmChart.availableIndicators()) as string[]).length;

const cargoToml = `[dependencies]
# Not on crates.io: pin a commit of the repository.
kestrel-loom = { git = "https://github.com/casoon/kestrel-loom", rev = "<commit>" }`;

const embedJs = `import { createChart } from './js/kestrel-loom.js';

const chart = await createChart(canvas, { timeframe: '5m', dark: true });

chart.data.set(candles);          // [{ time, o, h, l, c, v }], time in Unix seconds
chart.view.fit();
chart.indicators.add('rsi');      // any name from chart.indicators.available()
chart.tools.trendLine('t1', { time: 1600010000, price: 99 },
                            { time: 1600060000, price: 103 });`;
---

<Base>
  <Hero
    title="Trading charts in the browser, drawn by Rust."
    lead="kestrel-loom renders candlestick charts, indicator panes and drawing tools onto a canvas. Chart state, viewport math and the render loop are plain Rust compiled to WebAssembly; the indicators come from kestrel-chartkit."
  >
    <Install
      commands={[
        {
          label: 'build',
          command:
            'git clone https://github.com/casoon/kestrel-loom && cd kestrel-loom && ./build-wasm.sh',
        },
        {
          label: 'cargo',
          command: 'cargo add kestrel-loom --git https://github.com/casoon/kestrel-loom',
        },
      ]}
    />
    <Badges>
      <Badge>BUSL-1.1</Badge>
      <Badge tone="brand">alpha</Badge>
      <Badge>v0.1.0</Badge>
      <Badge>Rust 1.87+</Badge>
      <Badge>not on crates.io / npm</Badge>
    </Badges>
    <p class="demo-link">
      <Button href={url('demo/')}>Open the live demo</Button>
    </p>
    <CodeBlock
      slot="output"
      code={head(tools, 14)}
      title="tests/fixtures/tools_trend_and_level.txt"
      label="RenderCommand stream"
      copy={false}
    />
  </Hero>

  <Facts
    items={[
      { value: String(indicatorCount), label: 'indicators from kestrel-chartkit, reported by the WASM build' },
      { value: '8', label: 'chart types, from candlestick to Renko and footprint' },
      { value: String(Object.keys(fixtures).length), label: 'golden RenderCommand fixtures in the core tests' },
      { value: '0', label: 'browser dependencies in the core crate, checked in CI' },
    ]}
  />

  <Features
    items={[
      {
        title: 'A core without a browser',
        body: 'The <code>kestrel-loom</code> crate produces <code>RenderCommand</code>s and never touches a canvas. CI fails if it grows a <code>web-sys</code>, <code>js-sys</code> or <code>wasm-bindgen</code> dependency, so a whole frame stays testable in plain Rust.',
      },
      {
        title: 'Indicators fed bar by bar',
        body: 'Every indicator of kestrel-chartkit is updated with <code>on_bar</code> per new bar, without recomputing a window. Price-unit indicators draw on the price chart, oscillators get their own pane; multi-line outputs such as MACD signal and histogram are drawn, not dropped.',
      },
      {
        title: 'An axis that skips the weekend',
        body: 'Bars are positioned by index, not by timestamp: a 49-hour trading pause takes one bar of width. Time stays the outward contract — tool anchors, export and crosshair all speak Unix seconds.',
      },
      {
        title: 'Input told apart',
        body: 'Mouse wheel, trackpad and pinch are handled differently: continuous zoom, two-axis panning, kinetic glide after release, and a time scrollbar with a draggable handle.',
      },
      {
        title: 'One wrapper to embed',
        body: '<code>js/kestrel-loom.js</code> groups the flat WASM façade into <code>data</code>, <code>view</code>, <code>style</code>, <code>indicators</code>, <code>tools</code>, <code>compare</code> and <code>state</code>, and handles canvas sizing, input wiring and a render loop that only draws when something changed.',
      },
    ]}
  />

  <BuildOutput
    caption="Not a picture of a chart: the first commands of a full frame with an RSI pane, as the core writes it into a recorder. The test compares all of it on every run, so a change in drawing behaviour fails even when the result still looks plausible in a browser."
    file="crates/renderer/tests/fixtures/full_frame_with_rsi_pane.txt"
  >
    <CodeBlock code={head(rsi, 24)} copy={false} />
  </BuildOutput>

  <Quickstart
    lead="Build the WASM package from the repository, load the wrapper and hand it a canvas. The documentation covers data, indicators, tools and the Rust core."
    steps={[
      'Clone the repository and run <code>./build-wasm.sh</code>; it writes the package to <code>pkg/</code>.',
      'Serve <code>js/</code> and <code>pkg/</code> next to each other and import <code>createChart</code>.',
      'Set candles in Unix seconds, fit the view, add indicators and tools.',
    ]}
  >
    <CodeBlock code={embedJs} lang="js" title="chart.js" label="JavaScript" />
    <CodeBlock code={cargoToml} lang="toml" title="Cargo.toml" label="Rust core" />
  </Quickstart>
</Base>

<style>
  .demo-link {
    margin: 20px 0 0;
  }
</style>
